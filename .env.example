# Discord bot
DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=http://localhost:3000/callback
BOT_OWNER_ID=replace_me
AUTO_REGISTER_COMMANDS=true
# DEV_GUILD_ID=optional_test_server_id
PREFIX=!

# Web dashboard
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
COOKIE_SECURE=false

# MySQL / MariaDB
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=multibot
DATABASE_PASSWORD=replace_me
DATABASE_NAME=multibot
DATABASE_CONNECTION_LIMIT=10

# Twitch application credentials
TWITCH_CLIENT_ID=replace_me
TWITCH_CLIENT_SECRET=replace_me
TWITCH_POLL_INTERVAL_MS=120000
